{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "ES2022",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "dom"
    ],
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "downlevelIteration": true,
    "paths": {
      "undici-types": [
        "./node_modules/undici-types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/*.ts"
  ]
}
